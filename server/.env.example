## Server environment variables
## Copy to `.env` and fill in real values.

# Express server port (client is hardcoded to call localhost:5001)
PORT=5001

# Supabase (required)
# Example: https://xxxx.supabase.co
SUPABASE_URL=
# Use a project API key (usually the anon/public key) unless you intentionally use service_role.
SUPABASE_KEY=

# JWT (optional: code falls back, but set it for security)
JWT_SECRET=change_me

# Email (optional: only needed if you want email notifications to work)
EMAIL_USER=
EMAIL_PASS=

